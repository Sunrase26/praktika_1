def check_number(n):
    if n % 2 == 0:
        print(f"{n} - Чётное")
    else:
        print(f"{n} - Нечётное")

    if n > 0:
        print(f"{n} - Положительное")
    elif n < 0:
        print(f"{n} - Отрицательное")
    else:
        print(f"{n} - Ноль")

    if 10 <= n <= 50:
        print(f"{n} - Принадлежит диапазону [10; 50]")
    else:
        print(f"{n} - Не принадлежит диапазону [10; 50]")


check_number(int(input("Введи число: ")))


