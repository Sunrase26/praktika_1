text = input("Введи текст: ").lower()
counts = {}
for char in text:
    counts[char] = text.count(char)
top3 = sorted(counts.items(), key=lambda x: x[1], reverse=True)[:3]
print("3 самых частых символа:")
for char, count in top3:
    print(f"Символ '{char}' встречается {count} раз(а)")


# ====================5 задачка====================
print("=" * 10 + "5 задачка" + "=" * 10)

n = int(input("Введи число N: "))
primes = set(range(2, n + 1))
p = 2
while p * p <= n:
    if p in primes:
        for i in range(p * p, n + 1, p):
            primes.discard(i)
    p += 1
result = sorted(list(primes))
print(f"Простые числа от 2 до {n}:")
print(result)

# ====================6 задачка====================
print("=" * 10 + "6 задачка" + "=" * 10)
N = int(input("Введите индекс: "))
N_copy = N
n = 1
while N - 9 * n * 10 ** (n - 1) > 0:
    N -= 9 * n * 10 ** (n - 1)
    n += 1

kolvo_skip = (
    N - 1
) // n  # столько чисел мы скипнули в блоке из n-значных чисел до нашего числа
samo_chislo = 10 ** (n - 1) + kolvo_skip  # само число, в котором находится N-ый символ
index_in_chislo = (N - 1) % n  # индекс в числе, которое мы нашли

print(f"Символ на позиции {N_copy}: {str(samo_chislo)[index_in_chislo]}")

