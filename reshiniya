print("=" * 10 + "3 задачка" + "=" * 10)
import random
import string


def generate_password():
    bukovki = [random.choice(string.ascii_uppercase) for _ in range(3)]
    ciferki = [random.choice(string.digits) for _ in range(3)]
    specials = [random.choice("!@#$%^*") for _ in range(2)]
    list_password = bukovki + ciferki + specials
    random.shuffle(list_password)
    password = "".join(list_password)
    return password


print("рандомный пароль: ", generate_password())

